{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BBForge",
  "version": "0.3.0",
  "identifier": "io.github.bbforge",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; worker-src blob:" },
    "windows": [{ "title": "BBForge", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640, "decorations": false }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
