{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Минимальные разрешения главного окна BBForge",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }, { "url": "mailto:*" }]
    }
  ]
}
