{
  "name": "bbforge",
  "private": true,
  "version": "0.5.0",
  "description": "Desktop BBCode editor and visual constructor for 4PDA posts",
  "repository": "https://github.com/1VicTim1/BBForge",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features desktop-runtime",
    "tauri:build": "tauri build --features desktop",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.10.0",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/language": "6.11.3",
    "@codemirror/search": "6.5.11",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "cmdk": "1.1.1",
    "lucide-react": "1.61.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.4"
  }
}
